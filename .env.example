# ---- Core ------------------------------------------------------------
DATABASE_URL=postgres://bms:bms_dev_password@localhost:5432/bookmystyle
# Used by `npm test` integration tests (a separate, disposable database)
TEST_DATABASE_URL=postgres://bms:bms_dev_password@localhost:5432/bookmystyle_test
# Public base URL of the app (used for links, QR codes, webhooks, SEO)
APP_URL=http://localhost:3000

# ---- Payments ----------------------------------------------------------
# "sandbox"  = built-in test gateway (development only, never moves money)
# "razorpay" = Razorpay (UPI / cards / net banking / wallets)
PAYMENT_PROVIDER=sandbox
# Sandbox signing secrets (development only). Generate with: openssl rand -hex 32
SANDBOX_KEY_SECRET=change-me-sandbox-key-secret
SANDBOX_WEBHOOK_SECRET=change-me-sandbox-webhook-secret
# Razorpay (test keys start with rzp_test_). Never expose KEY_SECRET to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Notifications (optional channel adapters) --------------------------
# Leave empty to deliver in-app only (other channels are logged).
SMTP_URL=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Storage ---------------------------------------------------------------
# "local" writes uploads to ./public/uploads (dev). "s3" requires the vars below.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Background jobs -----------------------------------------------------
# Run the in-process sweeper (expired locks, reminders, no-shows). Disable when
# running a dedicated worker (`npm run worker`).
RUN_SWEEPER=true
